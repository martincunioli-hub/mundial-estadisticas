<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Estadísticas Mundial | Probabilidades</title>
  <link rel="stylesheet" href="styles.css" />
</head>
<body>
  <header>
    <div class="brand">
      <h1>Portal Mundial</h1>
      <p>Estadísticas, probabilidades y análisis de selecciones</p>
    </div>
    <div class="note">Datos simulados basados en ranking FIFA y estadísticas históricas de selecciones.</div>
  </header>

  <main>
    <section class="controls">
      <div class="control-group">
        <label for="teamSelect">Selecciona una selección</label>
        <select id="teamSelect"></select>
      </div>
      <div class="control-group">
        <label for="opponentSelect">Selecciona un rival</label>
        <select id="opponentSelect"></select>
      </div>
      <div class="control-group">
        <label for="statSelect">Mostrar</label>
        <select id="statSelect">
          <option value="overview">Visión general</option>
          <option value="ranking">Ranking FIFA</option>
          <option value="probability">Probabilidad de victoria</option>
          <option value="goals">Goles promedio</option>
          <option value="cards">Tarjetas amarillas</option>
        </select>
      </div>
    </section>

    <section class="summary-grid" id="summaryGrid"></section>

    <section class="tables">
      <div class="table-card">
        <h2>Ranking FIFA y forma</h2>
        <table id="rankingTable">
          <thead>
            <tr>
              <th>Selección</th>
              <th>Ranking</th>
              <th>Partidos</th>
              <th>Win %</th>
              <th>Goles</th>
              <th>Amarillas</th>
            </tr>
          </thead>
          <tbody></tbody>
        </table>
      </div>

      <div class="table-card">
        <h2>Probabilidad de victoria vs rival</h2>
        <div class="match-probability" id="probabilityCard"></div>
      </div>
    </section>

    <section class="sources">
      <h2>Fuentes y enfoque</h2>
      <ul>
        <li>Ranking FIFA actualizado</li>
        <li>Estadísticas de goles, tarjetas y resultados de selecciones</li>
        <li>Modelos de probabilidad básicos similares a páginas de apuestas</li>
      </ul>
    </section>
  </main>

  <script src="script.js"></script>
</body>
</html>

